<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.debatechecker</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0</version>
    <name>debate-checker-backend</name>

    <properties>
        <java.version>21</java.version>
        <sherpa-onnx.version>v1.13.8</sherpa-onnx.version>
    </properties>

    <!-- sherpa-onnx (local speech models) is published through JitPack, not Maven Central. -->
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Java API for sherpa-onnx: VAD, speech-to-text, speaker embeddings -->
        <dependency>
            <groupId>com.github.k2-fsa.sherpa-onnx</groupId>
            <artifactId>sherpa-onnx-jvm</artifactId>
            <version>${sherpa-onnx.version}</version>
        </dependency>
        <!-- Native libraries for Windows x64. On Linux use sherpa-onnx-native-lib-linux-x64,
             on an Intel Mac sherpa-onnx-native-lib-osx-x64, on Apple Silicon ...-osx-aarch64. -->
        <dependency>
            <groupId>com.github.k2-fsa.sherpa-onnx</groupId>
            <artifactId>sherpa-onnx-native-lib-win-x64</artifactId>
            <version>${sherpa-onnx.version}</version>
        </dependency>
        <!-- Java API for the claim gate (classifier/). Only its JNI bridge is used: ClaimGate runs it
             on the onnxruntime.dll inside the sherpa-onnx natives (1.28.2 in v1.13.8), so keep this
             at the same minor version. -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.28.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
