{
  "manifest_version": 3,
  "name": "Podium: Debate Fact Checker",
  "version": "0.5.0",
  "description": "Real-time fact-checking for YouTube debates.",
  "permissions": ["tabCapture", "offscreen", "activeTab", "scripting"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Start / stop fact-checking this tab"
  }
}
